default :
{
    name : 'scipy'
    build_source : 'script'
    compil_script : $name + $VARS.scriptExtension
    get_source : 'release'
    web_link : 'https://github.com/scipy/scipy/archive/refs/tags/v' + $version + '.tar.gz'
    system_info :
    {
        rpm :
        [
            'python3-scipy'
        ]
        rpm_dev : [ ]
        apt :
        [
            'python3-scipy'
        ]
        apt_dev : [ ]
    }
    archive_info :
    {
        archive_name : 'scipy-' + $APPLICATION.products.scipy + '.tar.gz'
    }
    patches : [ ]
    environ :
    {
        env_script : $name + '.py'
    }
    depend :
    [
        'Python'
        'numpy'
        'openblas'
        'boost'
    ]
    source_dir : $APPLICATION.workdir + $VARS.sep + 'SOURCES' + $VARS.sep + $name
    build_dir : $APPLICATION.workdir + $VARS.sep + 'BUILD' + $VARS.sep + $name
    properties :
    {
        incremental : 'yes'
        pip : 'no'
    }
}

version_1_18_0:
{
    web_link : 'https://files.pythonhosted.org/packages/a7/25/c2700dfaf6442b4effaa91af24ebce5dc9d31bb4a69706313aae70d72cd0/scipy-1.18.0.tar.gz'
}